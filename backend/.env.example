# Development-only example. Replace placeholders locally and keep real secrets PRIVATE.
# Copy this file to backend/.env. Never commit backend/.env.
# Choose the NEW Neon project "DevCollab AI", branch "development", database "devcollab".
# Pooled connection for the app (later; runtime Prisma adapter).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/devcollab?sslmode=require"
# Direct connection for migrations only (non-pooler host).
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/devcollab?sslmode=require"
